{
  "name": "crm_frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "generate-openapi-client": "npm run generate-openapi-client:clean  && npm run generate-openapi-client:app",
    "generate-openapi-client:clean": "rimraf src-gen/openapi",
    "generate-openapi-client:app": "openapi-generator-cli generate -g typescript-fetch -c openapitools.json -i ../backend_express/openapi.yml -o src-gen/openapi/app",
    "lint:check": "eslint ./src --ext .ts,.tsx"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@reduxjs/toolkit": "^1.9.7",
    "@syncfusion/ej2": "^23.1.41",
    "@syncfusion/ej2-react-calendars": "^23.1.41",
    "@syncfusion/ej2-react-charts": "^23.1.41",
    "@syncfusion/ej2-react-dropdowns": "^23.1.41",
    "@syncfusion/ej2-react-grids": "^23.1.41",
    "@syncfusion/ej2-react-inputs": "^23.1.40",
    "@syncfusion/ej2-react-kanban": "^23.1.36",
    "@syncfusion/ej2-react-popups": "^23.1.38",
    "@syncfusion/ej2-react-schedule": "^23.1.40",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@tanstack/react-table": "^8.10.7",
    "axios": "^1.12.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.290.0",
    "react": "^18.2.0",
    "react-day-picker": "^9.11.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.63.0",
    "react-icons": "^4.11.0",
    "react-redux": "^8.1.3",
    "react-router-dom": "^6.17.0",
    "tailwind-merge": "^1.14.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.24.0",
    "@types/node": "^20.8.9",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.0.2",
    "vite": "^7.1.7"
  }
}
